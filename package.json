{
  "name": "omniagent",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.17.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "postinstall": "node scripts/prepare-linux-sandbox.ts",
    "dev": "tsx packages/tui/src/main.ts",
    "web": "pnpm web:build && tsx packages/web/src/main.ts",
    "web:build": "pnpm --filter @omniagent/web build",
    "web:dev": "pnpm --filter @omniagent/web dev",
    "web:serve": "tsx packages/web/src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "tsx packages/core/src/eval/run.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
