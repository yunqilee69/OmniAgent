{
  "model": "deepseek-flash",
  "provider": "deepseek-official",
  "reasoningEffort": "high",
  "maxTokens": 256000,
  "providers": {
    "deepseek-official": {
      "apiKeyEnv": "DEEPSEEK_API_KEY"
    }
  },
  "dsh": {
    "permission": {
      "defaultPreset": "workspace-write"
    }
  },
  "maxSteps": 25,
  "subagents": {
    "maxDepth": 1,
    "maxActive": 8
  }
}
