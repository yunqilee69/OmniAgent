{
  "model": "deepseek-flash",
  "provider": "deepseek-official",
  "reasoningEffort": "high",
  "maxTokens": 8192,
  "web": {
    "host": "127.0.0.1",
    "port": 4317,
    "auth": {
      "enabled": false,
      "username": "",
      "password": ""
    }
  },
  "providers": {
    "deepseek-official": {
      "apiKeyEnv": "DEEPSEEK_API_KEY",
      "models": [
        {
          "id": "deepseek-flash",
          "name": "DeepSeek V4.1 Flash",
          "contextWindow": 1048576,
          "maxTokens": 8192,
          "input": ["text", "image"],
          "capabilities": { "imageInput": true },
          "reasoning": {
            "efforts": { "off": null, "low": "low", "high": "high", "max": "max" },
            "default": "high"
          }
        },
        {
          "id": "deepseek-v4-pro",
          "name": "DeepSeek V4 Pro",
          "contextWindow": 1048576,
          "input": ["text"],
          "capabilities": { "imageInput": false },
          "reasoning": {
            "efforts": { "off": null, "low": "low", "high": "high", "max": "max" },
            "default": "high"
          }
        }
      ]
    }
  },
  "roles": {
    "quick": {
      "name": "快速",
      "provider": "deepseek-official",
      "model": "deepseek-flash",
      "reasoningEffort": "low"
    },
    "advanced": {
      "name": "高级",
      "provider": "deepseek-official",
      "model": "deepseek-flash",
      "reasoningEffort": "max"
    }
  },
  "agentProfiles": {
    "default": {
      "tools": "*",
      "skills": "*"
    },
    "search-only": {
      "tools": ["read_file", "list_dir", "glob", "grep", "web_fetch", "skill"],
      "skills": ["web-research", "source-review"]
    },
    "coding": {
      "tools": [
        "read_file",
        "write_file",
        "edit_file",
        "list_dir",
        "glob",
        "grep",
        "web_fetch",
        "bash",
        "skill",
        "todo_write",
        "exit_plan_mode",
        "get_goal",
        "create_goal",
        "update_goal",
        "subagent"
      ],
      "skills": "*"
    }
  },
  "mcpServers": {
    "filesystem": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "/path/to/workspace"],
      "env": {},
      "timeoutMs": 60000
    },
    "remote-example": {
      "type": "http",
      "url": "https://example.com/mcp",
      "headers": {
        "Authorization": "Bearer ${MCP_TOKEN}"
      },
      "enabled": false
    }
  },
  "dsh": {
    "permission": {
      "defaultPreset": "workspace-write"
    }
  },
  "maxSteps": 25,
  "subagents": {
    "maxDepth": 1,
    "maxActive": 8
  },
  "todo": {
    "allowParallelInProgress": true
  }
}
